{
  "name": "devcontainer-lsp",
  "owner": {
    "name": "MediatrUnionPoc dev container"
  },
  "metadata": {
    "description": "Language servers baked into the MediatrUnionPoc dev container image"
  },
  "plugins": [
    {
      "name": "devcontainer-lsp",
      "source": "./devcontainer-lsp",
      "description": "Markdown, JSON, YAML and Bash language servers installed in the dev container image.",
      "strict": false,
      "lspServers": {
        "markdown": {
          "command": "marksman",
          "args": [
            "server"
          ],
          "extensionToLanguage": {
            ".md": "markdown"
          }
        },
        "json": {
          "command": "vscode-json-language-server",
          "args": [
            "--stdio"
          ],
          "extensionToLanguage": {
            ".json": "json",
            ".jsonc": "jsonc"
          }
        },
        "yaml": {
          "command": "yaml-language-server",
          "args": [
            "--stdio"
          ],
          "extensionToLanguage": {
            ".yml": "yaml",
            ".yaml": "yaml"
          }
        },
        "bash": {
          "command": "bash-language-server",
          "args": [
            "start"
          ],
          "extensionToLanguage": {
            ".sh": "shellscript",
            ".bash": "shellscript"
          }
        }
      }
    }
  ]
}
