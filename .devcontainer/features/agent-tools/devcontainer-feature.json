{
  "id": "agent-tools",
  "version": "1.0.0",
  "name": "Claude Code, language servers and code graph (pinned)",
  "description": "Pinned Claude Code, csharp-ls, marksman, YAML/JSON/Bash language servers and the codebase-memory-mcp code-graph binary, in root-owned prefixes, plus ripgrep and shellcheck. Downloaded binaries are SHA-256 checked.",
  "options": {
    "claudeCodeVersion": {
      "type": "string",
      "default": "2.1.278",
      "description": "@anthropic-ai/claude-code npm version"
    },
    "csharpLsVersion": {
      "type": "string",
      "default": "0.27.0",
      "description": "csharp-ls dotnet tool version (keep equal to .config/dotnet-tools.json)"
    },
    "yamlLsVersion": {
      "type": "string",
      "default": "1.24.0",
      "description": "yaml-language-server npm version"
    },
    "langserversExtractedVersion": {
      "type": "string",
      "default": "4.10.0",
      "description": "vscode-langservers-extracted npm version (JSON language server)"
    },
    "bashLsVersion": {
      "type": "string",
      "default": "5.8.1",
      "description": "bash-language-server npm version"
    },
    "marksmanVersion": {
      "type": "string",
      "default": "2026-02-08",
      "description": "marksman release tag"
    },
    "marksmanSha256": {
      "type": "string",
      "default": "be5098e8213219269c47fc0d916a66fa31ce0602ec967475c722260aabf26087",
      "description": "SHA-256 of marksman-linux-x64 for marksmanVersion"
    },
    "codebaseMemoryVersion": {
      "type": "string",
      "default": "0.11.0",
      "description": "codebase-memory-mcp release version"
    },
    "codebaseMemorySha256": {
      "type": "string",
      "default": "1f9e8293eb2bc5c05cfa27a7e8fc033da6d729ffad525ccfcdaa3fd606306683",
      "description": "SHA-256 of codebase-memory-mcp-linux-amd64-portable.tar.gz for codebaseMemoryVersion"
    }
  },
  "containerEnv": {
    "PATH": "/opt/npm-global/bin:/opt/dotnet-tools:${PATH}",
    "DISABLE_AUTOUPDATER": "1",
    "DOTNET_ROLL_FORWARD": "Major"
  },
  "installsAfter": [
    "ghcr.io/devcontainers/features/dotnet",
    "ghcr.io/devcontainers/features/node"
  ]
}
