@MediatrUnionPoc.Api_HostAddress = http://localhost:5233

# Every product endpoint needs a bearer token. In Development, mint one with:
#   dotnet user-jwts create --project src/MediatrUnionPoc.Api --name alice
#   dotnet user-jwts create --project src/MediatrUnionPoc.Api --name root --role Administrator
# and paste the printed tokens here. The token's "sub" is the caller (the owner of what it creates);
# a "role" of Administrator is needed to delete.
@token = <alice's token>
# Impersonation needs a token whose role is Administrator or Support (see the request below).
@supportToken = <a support user's token>
@adminToken = <the administrator's token>

GET {{MediatrUnionPoc.Api_HostAddress}}/openapi/v1.json
Accept: application/json

###

# Create: 201 with ETag: W/"1". The token's sub becomes the owner. 401 without a token.
POST {{MediatrUnionPoc.Api_HostAddress}}/api/products
Authorization: Bearer {{token}}
Content-Type: application/json

{ "name": "Widget", "price": 9.99 }

###

# List: 200 with X-Total-Count and Link headers.
GET {{MediatrUnionPoc.Api_HostAddress}}/api/products?sort=name,-price&pageSize=10
Authorization: Bearer {{token}}
Accept: application/json

###

# The requests below need an id and its current ETag from the create/get responses.
@id = 00000000-0000-0000-0000-000000000001

GET {{MediatrUnionPoc.Api_HostAddress}}/api/products/{{id}}
Authorization: Bearer {{token}}
Accept: application/json

###

# Replace: 204 with the new ETag. If-Match is required (428 without it).
PUT {{MediatrUnionPoc.Api_HostAddress}}/api/products/{{id}}
Authorization: Bearer {{token}}
If-Match: W/"1"
Content-Type: application/json

{ "name": "Widget Pro", "price": 19.99 }

###

# Partial update (JSON Merge Patch): 200 with the product and the new ETag.
PATCH {{MediatrUnionPoc.Api_HostAddress}}/api/products/{{id}}
Authorization: Bearer {{token}}
If-Match: W/"2"
Content-Type: application/merge-patch+json

{ "price": 14.99 }

###

# Delete: 204. Administrator only; If-Match is optional here.
DELETE {{MediatrUnionPoc.Api_HostAddress}}/api/products/{{id}}
Authorization: Bearer {{adminToken}}

###

# Impersonation: 200 with a short-lived token acting as "alice" (its act claim names the caller).
# Needs the Administrator or Support role; reason is required (10 to 500 characters). 403 when the
# caller is already using an impersonation token, or asks for a role it may not grant (a Support user
# cannot grant Administrator); 404 when Impersonation:Enabled is false. The response is never cached.
POST {{MediatrUnionPoc.Api_HostAddress}}/api/impersonation/tokens
Authorization: Bearer {{supportToken}}
Content-Type: application/json

{
  "targetUserId": "alice",
  "roles": ["Support"],
  "reason": "Reproducing the checkout error alice reported",
  "ticketReference": "SUP-1234",
  "lifetimeMinutes": 15
}

###
