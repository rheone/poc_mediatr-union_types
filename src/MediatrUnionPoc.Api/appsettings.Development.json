{
  "Serilog": {
    "WriteTo": {
      "Console": {
        "Args": {
          "formatter": null,
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {TraceId} {UserId} {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      }
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:4200",
      "http://localhost:3000"
    ]
  },
  "Authentication": {
    "Jwt": {
      "SigningKey": "DEVELOPMENT-ONLY-signing-key-never-use-outside-local-development"
    },
    "DevIdentity": {
      "UserId": null,
      "Roles": null
    },
    "Schemes": {
      "Bearer": {
        "ValidAudiences": [
          "http://localhost:5233",
          "https://localhost:7070"
        ],
        "ValidIssuer": "dotnet-user-jwts"
      }
    }
  },
  "Impersonation": {
    "SigningKey": "DEVELOPMENT-ONLY-impersonation-key-never-use-outside-local-development"
  }
}